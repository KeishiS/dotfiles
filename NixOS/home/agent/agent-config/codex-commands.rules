prefix_rule(
    pattern = ["nix", "develop", "-c", ["cargo", "npm"]],
    decision = "allow",
    justification = "Nix開発環境内でRustとnpmの検証を許可する"
)

prefix_rule(
    pattern = ["nix", ["build", "fmt", "eval"]],
    decision = "allow",
    justification = "Nixによるフォーマット・ビルド・評価を許可する",
    match = [
        "nix fmt -- flake.nix"
    ]
)

prefix_rule(
    pattern = ["nix", "flake", "check"],
    decision = "allow"
)

prefix_rule(
    pattern = ["git", ["diff", "log", "show", "status", "fetch", "ls-remote"]],
    decision = "allow",
    justification = "Gitでの読み取り操作を許可する"
)

prefix_rule(
    pattern = ["git", "switch", "-c"],
    decision = "allow",
    justification = "新しい作業ブランチの作成を許可する"
)

prefix_rule(
    pattern = ["cargo", ["build", "check", "clippy", "doc", "fmt", "metadata", "test", "tree"]],
    decision = "allow",
    justification = "Rustの構築・読み取り・検証操作を許可する"
)

prefix_rule(
    pattern = ["cargo", "make"],
    decision = "allow",
    justification = "Makefile.tomlに定義したタスクを許可する"
)

prefix_rule(
    pattern = ["gh", "auth", "status"],
    decision = "allow"
)

prefix_rule(
    pattern = ["gh", "repo", ["view", "list", "read-file"]],
    decision = "allow"
)


prefix_rule(
    pattern = ["gh", "pr", ["list", "view", "diff", "checks", "status"]],
    decision = "allow",
    justification = "Pull Requestの読み取り操作を許可する"
)

prefix_rule(
    pattern = ["gh", "issue", ["list", "view"]],
    decision = "allow",
    justification = "Issueの読み取り操作を許可する"
)

prefix_rule(
    pattern = ["gh", "run", ["list", "view", "watch"]],
    decision = "allow",
    justification = "GitHub Actionsの実行状況の確認を許可する"
)

prefix_rule(
    pattern = ["gh", "run", ["rerun", "cancel"]],
    decision = "prompt",
    justification = "GitHub Actionsの再実行または中止は外部状態を変更するため確認する"
)

prefix_rule(
    pattern = ["gh", "workflow", "list"],
    decision = "allow"
)

prefix_rule(
    pattern = ["gh", "workflow", "run"],
    decision = "prompt",
    justification = "GitHub Actions workflowの開始は外部状態を変更するため確認する"
)

prefix_rule(
    pattern = ["gh", "release", ["list", "view"]],
    decision = "allow"
)

prefix_rule(
    pattern = ["gh", "release", "create"],
    decision = "prompt",
    justification = "GitHub Releaseの作成は外部公開を伴うため確認する"
)

prefix_rule(
    pattern = ["gh", "label", "list"],
    decision = "allow"
)

prefix_rule(
    pattern = ["gh", "api"],
    decision = "prompt",
    justification = "GitHub APIによる書き込みには投稿前検査が適用されないため、実行内容を確認する"
)
