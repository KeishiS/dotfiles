prefix_rule(
    pattern = ["git", ["diff", "log", "show", "status", "ls-remote"]],
    decision = "allow",
    justification = "Gitの差分・履歴・状態の確認を許可します。"
)

prefix_rule(
    pattern = ["gh", "auth", "status"],
    decision = "allow"
)

prefix_rule(
    pattern = ["gh", "repo", ["view", "list", "read-file"]],
    decision = "allow"
)


prefix_rule(
    pattern = ["gh", "pr", ["list", "view", "diff", "checks", "status"]],
    decision = "allow",
    justification = "Pull Requestの読み取り操作を許可します。"
)

prefix_rule(
    pattern = ["gh", "issue", ["list", "view"]],
    decision = "allow",
    justification = "Issueの読み取り操作を許可します。"
)

prefix_rule(
    pattern = ["gh", "run", ["list", "view", "watch"]],
    decision = "allow",
    justification = "GitHub Actionsの実行状況の確認を許可します。"
)

prefix_rule(
    pattern = ["gh", "run", ["rerun", "cancel"]],
    decision = "prompt",
    justification = "GitHub Actionsの再実行または中止は外部状態を変更するため確認します。"
)

prefix_rule(
    pattern = ["gh", "workflow", "list"],
    decision = "allow"
)

prefix_rule(
    pattern = ["gh", "workflow", "run"],
    decision = "prompt",
    justification = "GitHub Actions workflowの開始は外部状態を変更するため確認します。"
)

prefix_rule(
    pattern = ["gh", "release", ["list", "view"]],
    decision = "allow"
)

prefix_rule(
    pattern = ["gh", "release", "create"],
    decision = "prompt",
    justification = "GitHub Releaseの作成は外部公開を伴うため確認します。"
)

prefix_rule(
    pattern = ["gh", "label", "list"],
    decision = "allow"
)

prefix_rule(
    pattern = ["gh", "api"],
    decision = "prompt",
    justification = "GitHub APIは読み取りと書き込みの両方に使えるため、実行内容を確認します。"
)
